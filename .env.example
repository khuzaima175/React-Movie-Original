# Server-side credentials (Vercel / Serverless API routes — recommended for production; NEVER exposed in browser bundle)
GEMINI_API_KEY=your_gemini_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# Optional local-dev client fallback when running `npm start` without `vercel dev` (do NOT set on public Vite builds)
# VITE_GEMINI_KEY=your_local_dev_gemini_key_here
# VITE_TMDB_KEY=your_local_dev_tmdb_key_here
# VITE_OMDB_KEY=your_local_dev_omdb_key_here

# Optional Supabase Cloud Vault Sync (publishable anon/sb_publishable key only — NEVER expose service_role)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
